# =========================================
# SIEM/SOAR AI System - Environment Config
# =========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# --- REQUIRED ---
# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# --- DATABASE ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=siemsoar
DB_URL=postgresql+asyncpg://postgres:change_this_strong_password@postgres:5432/siemsoar

# --- SECURITY ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- ELASTICSEARCH ---
ES_HOST=elasticsearch
ES_PORT=9200
ES_URL=http://elasticsearch:9200
# Uncomment for production with auth:
# ES_USERNAME=elastic
# ES_PASSWORD=your_es_password

# --- REDIS ---
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --- GRAFANA ---
GRAFANA_PASSWORD=admin_change_me

# --- OPTIONAL: Threat Intelligence APIs ---
# AbuseIPDB (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# VirusTotal (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# Shodan (https://account.shodan.io/)
SHODAN_API_KEY=

# --- OPTIONAL: Notification Channels ---
# Slack incoming webhook URL
SLACK_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siem@yourdomain.com
ALERT_EMAIL=soc@yourdomain.com

# --- OPTIONAL: Ticketing Systems ---
# JIRA
JIRA_URL=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SOC

# ServiceNow
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# --- OPTIONAL: Cloud Log Collection ---
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_CLOUDTRAIL_BUCKET=

# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# --- COLLECTOR SETTINGS ---
LOG_WATCH_PATHS=/var/log/auth.log,/var/log/nginx/access.log,/var/log/syslog
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=601

# --- APP SETTINGS ---
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
